# Copy to .env and fill in. Lines starting with # are ignored.

# --- What to watch -------------------------------------------------------
START_URL=https://www.passport.gov.ph/appointment
# Format: Label::regex (regex is matched, case-insensitive, against the dropdown option text)
SITES=Davao (SM City Davao)::^\s*DAVAO\s*\(\s*SM CITY,Tagum (Robinsons Place Tagum)::^\s*TAGUM\s*\(\s*ROBINSONS
MONTHS=October,November,December
# YEAR=2026            # optional; if set, the calendar label must contain it

# --- Notifications (configure at least one) ------------------------------
# 1) Phone push via ntfy (free): install the "ntfy" app, subscribe to a long random topic
NTFY_TOPIC=
# 2) Email via Gmail (needs an App Password: Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=
# 3) Telegram bot (free): talk to @BotFather for a token, then message your bot and get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 4) SMS in the Philippines via Semaphore (paid per SMS): https://semaphore.co
SEMAPHORE_API_KEY=
SMS_TO=                # e.g. 09171234567
SEMAPHORE_SENDER=
# 5) macOS banner notification (only visible while the Mac is awake)
MAC_NOTIFY=1

# --- Behaviour -----------------------------------------------------------
HEARTBEAT_HOUR=20      # daily "still running" message after this hour (0-23); -1 disables
NEXT_BUTTON_TEXT=^(next|continue|proceed|submit|agree|accept)\b

# --- Selector overrides (only if auto-detection fails; see README) -------
# SEL_MONTH_LABEL=
# SEL_MONTH_NEXT=
# SEL_AVAILABLE_DAY=
